[Unit]
Description=OTP grabber (Melia email and Google Messages codes)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/otp-grabber daemon
Restart=on-failure
RestartSec=2
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SESSION_TYPE=wayland

[Install]
WantedBy=default.target
